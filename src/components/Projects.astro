---
import ProjectItem from './ProjectItem.astro';
import naranja1Img from '../assets/naranja1.jpg';
import naranja2Img from '../assets/naranja2.jpg';
import naranja3Img from '../assets/naranja3.jpg';
import erp1Img from '../assets/erp1.jpg';
import erp2Img from '../assets/erp2.jpg';
import erp3Img from '../assets/erp3.jpg';
import crmMarimboImg from '../assets/crmMarimbo.svg';
import conciliacionImg from '../assets/conciliacion.svg';
import conciliacionArquitecturaImg from '../assets/conciliacionArquitectura.svg';
import conciliacionImpactoImg from '../assets/conciliacionImpacto.svg';
import valesOcrImg from '../assets/valesOcr.svg';
import cartaPorteImg from '../assets/cartaPorte.svg';
import erpArquitecturaImg from '../assets/erpArquitectura.svg';

const PROJECTS = [
    {
        id_prefix: 'proj13',
        title: 'Conciliación Bancaria Asistida por IA',
        description: 'Backend Django/DRF que normaliza extractos de seis bancos argentinos, ejecuta reglas determinísticas y usa IA únicamente para los casos ambiguos. La decisión final permanece bajo control humano y cada resultado conserva trazabilidad.',
        impact: 'Resultado: -43% de tokens de entrada, 46 filas repetidas eliminadas y más de 160 pruebas automatizadas en el flujo productivo.',
        images: [conciliacionImg, conciliacionArquitecturaImg, conciliacionImpactoImg],
        tags: ['Django', 'DRF', 'Gemini', 'Celery', 'PostgreSQL', 'MinIO', 'Docker'],
        caseStudyUrl: 'https://github.com/MatiViglianco/MatiViglianco/blob/main/case-studies/ai-assisted-bank-reconciliation.md'
    },
    {
        id_prefix: 'proj8',
        title: 'CRM Multi-canal de WhatsApp',
        description: 'Plataforma operativa que reúne varios números de WhatsApp en una sola bandeja, con estados de resolución, salud de colas por canal, alertas, historial, audios y reportes. Frontend React sobre una API REST de Django.',
        impact: 'Impacto: un único punto de control para conversaciones comerciales, operaciones internas y documentación logística.',
        image: crmMarimboImg,
        tags: ['React', 'Django', 'DRF', 'WhatsApp Cloud API', 'PostgreSQL', 'Docker'],
        demoUrl: 'https://crm.marimbo.cloud/'
    },
    {
        id_prefix: 'proj6',
        title: 'ERP de Operaciones, Finanzas y RRHH',
        description: 'ERP modular con ventas, balanza, gastos, bancos, cuentas corrientes, facturación, cobranzas y sueldos. Incluye separación por sucursal, importaciones idempotentes, auditoría y flujos de revisión.',
        impact: 'Ingeniería verificable: 86 pruebas backend, pruebas E2E con Playwright, CI en GitHub Actions y despliegue containerizado.',
        images: [erp1Img, erp2Img, erp3Img, erpArquitecturaImg],
        tags: ['Django', 'DRF', 'React', 'PostgreSQL', 'MUI', 'Playwright', 'Docker'],
        repoUrl: 'https://github.com/MatiViglianco/ERP-Final'
    },
    {
        id_prefix: 'proj7',
        title: 'Vales OCR: Digitalización Asistida',
        description: 'Plataforma que transforma fotografías de vales manuscritos en lotes revisables: extracción con IA, normalización, matching contra clientes reales, alias aprendidos y carga controlada al ERP.',
        impact: 'Diseñada con revisión humana, trazabilidad por lote y despliegue automático para reducir errores de carga sin delegar decisiones sensibles a la IA.',
        image: valesOcrImg,
        tags: ['React', 'Django', 'OCR', 'Gemini', 'JWT', 'Nginx', 'GitHub Actions'],
        demoUrl: 'https://vales.mativiglianco.cloud/'
    },
    {
        id_prefix: 'proj5',
        title: 'Naranja Autoservicio',
        description: 'E-commerce Django/React con catálogo, stock, promociones, cupones, órdenes, carrito persistente y checkout por WhatsApp. Incluye búsqueda tolerante a acentos y estadísticas administrativas.',
        impact: 'Resultado: un canal de pedidos simple para clientes y una operación comercial centralizada para el negocio.',
        images: [naranja1Img, naranja2Img, naranja3Img],
        tags: ['Django', 'DRF', 'React', 'Vite', 'PostgreSQL', 'CI/CD', 'Docker'],
        repoUrl: 'https://github.com/MatiViglianco/naranja-autoservicio'
    },
    {
        id_prefix: 'proj9',
        title: 'Cartas de Porte por WhatsApp y ARCA',
        description: 'Bot conversacional con máquina de estados y sesiones persistentes que captura datos, valida la operación y emite Cartas de Porte electrónicas mediante WSCPE, SOAP y WSAA.',
        impact: 'Impacto: el cliente recibe CPE y CTG dentro del mismo flujo de WhatsApp, reduciendo carga manual y puntos de error.',
        image: cartaPorteImg,
        tags: ['Python', 'Django', 'ARCA/WSCPE', 'SOAP', 'WhatsApp Cloud API', 'Celery']
    }
];

const OTHER_PROJECTS = [
    { name: 'AppCuentaCorriente', url: 'https://github.com/MatiViglianco/AppCuentaCorriente', key: 'other_proj1' },
    { name: 'CoinLatam', url: 'https://github.com/julianvidela/coin-latam', key: 'other_proj2' },
    { name: 'P2Pbetting — Chainlink Hackathon', url: 'https://github.com/martinllobell/dapp', key: 'other_proj3' },
    { name: 'ITBANK', url: 'https://github.com/ItbaGrupo5', key: 'other_proj4' }
];
---
<section id="projects" class="py-20">
    <div class="mb-12 reveal-on-scroll">
        <h2 class="section-title text-3xl font-bold text-white mb-4 flex items-center" data-translate="projects_title">
            Casos de trabajo destacados
        </h2>
        <p class="text-gray-400 max-w-3xl text-lg" data-translate="projects_intro">
            Una selección breve de sistemas reales. Cada caso prioriza el problema operativo, las decisiones de ingeniería y el resultado por encima de una lista de tecnologías.
        </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        {PROJECTS.map(project => <ProjectItem {...project} />)}
    </div>

    <details class="mt-10 rounded-lg border border-slate-700/60 bg-slate-900/30 p-5 reveal-on-scroll">
        <summary class="cursor-pointer font-semibold text-purple-300" data-translate="other_projects_title">Otros proyectos y colaboraciones</summary>
        <ul class="mt-5 grid gap-4 md:grid-cols-2">
            {OTHER_PROJECTS.map(project => (
                <li>
                    <a class="font-semibold text-white hover:text-purple-300" href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
                    <p class="mt-1 text-sm text-gray-400" data-translate={project.key}></p>
                </li>
            ))}
        </ul>
    </details>
</section>
